; Engine configuration file - LoCal LoL (Godot 4.3+)
config_version=5

[application]

config/name="LoCal LoL"
run/main_scene="res://scenes/Login.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

Catalog="*res://scripts/Catalog.gd"
Api="*res://scripts/Api.gd"
Net="*res://scripts/Net.gd"
Gfx="*res://scripts/Gfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0
window/handheld/orientation=0

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=3
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=5
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=5
textures/default_filters/anisotropic_filtering_level=4
environment/ssao/quality=3
environment/ssil/quality=3
environment/subsurface_scattering/subsurface_scattering_quality=2
